{
  "manifest_version": 3,
  "name": "QEFT Bridge",
  "version": "0.1.0",
  "description": "QEFT (QC EDL Flash Tool) 浏览器桥接：把页面请求转发给本机 libusb 宿主，访问高通 9008 设备。",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://flash.geekhonize.top/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://flash.geekhonize.top/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "http://localhost:4173/*",
      "http://127.0.0.1:4173/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flash.geekhonize.top/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*"
      ],
      "js": [
        "inject-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://flash.geekhonize.top/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
